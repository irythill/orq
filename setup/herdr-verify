#!/usr/bin/env bash
# herdr-verify → `orq verify` (TypeScript CLI in src/, built to dist/ by install.sh). Kept so existing callers and the
# /issue playbook keep working; same flags (-w -r -d -b -o [-g], -x runs in the foreground), files and exit codes.
# As before, the run opens in a herdr tab whenever the herdr server is up (ORQ_TERMINAL overrides).
command -v herdr >/dev/null && herdr status server >/dev/null 2>&1 && export ORQ_TERMINAL=${ORQ_TERMINAL:-herdr}
exec node "$(dirname "$(realpath "$0")")/../dist/cli.js" verify "$@"
