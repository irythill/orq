#!/usr/bin/env bash
# herdr-conductor → `orq conductor` (TypeScript CLI in src/, built to dist/ by install.sh); the logic lives there and
# works in any terminal. This wrapper only keeps the old name and its check: it must run INSIDE herdr.
#
#   herdr-conductor [account|-] [model] [-r <session-id>]
. "$(dirname "$(realpath "$0")")/orq-i18n.sh"
[ "${HERDR_ENV:-}" = 1 ] || { echo "$(m "run it inside a herdr pane (open 'herdr' and call herdr-conductor there; elsewhere use: orq conductor)" "rode dentro de um pane do herdr (abra o 'herdr' e chame o herdr-conductor lá; fora dele use: orq conductor)")"; exit 2; }
exec node "$(dirname "$(realpath "$0")")/../dist/cli.js" conductor --agent claude "$@"
