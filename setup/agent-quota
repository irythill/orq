#!/bin/bash
# agent-quota [name...] — quota of each Claude account (`claude-accounts`), Codex, OpenCode and Antigravity (default: all).
# Uses Omarchy's collectors live (--force). Claude with CLAUDE_CONFIG_DIR and a cache per account (its cache is shared
# and, with an expired token, would show ANOTHER account's numbers).
# Output: "<name> 5h=NN% week=NN% [note]".
#   -  = the plan has no such window (e.g. Codex Plus only reports weekly): not limiting, decide by the other one.
#   ?  = no data (expired token, collector failed): don't use that account until you log in again.
fmt() {
  jq -r --arg a "$1" '
    def pct(l): ([.limits[]? | select(.label|test(l;"i")) | .percent*100|floor] | first);
    def show(v): if v == null then "-" else "\(v)%" end;
    if (.usageStatusText // "") != "" then "\($a) 5h=? week=? [\(.usageStatusText)]"
    elif ((.limits // []) | length) == 0 then "\($a) 5h=? week=? [no limit data]"
    else "\($a) 5h=\(show(pct("5-hour"))) week=\(show(pct("7-day|weekly")))" end' 2>/dev/null \
    || echo "$1 5h=? week=? [collector failed]"
}
want() { [ $# -le 1 ] || [[ " ${*:2} " == *" $1 "* ]]; }

claude-accounts | sort -u -k2,2 |
while read -r acc dir; do
  want "$acc" "$@" || continue
  cache="$HOME/.cache/agent-quota/$acc"; mkdir -p "$cache"
  CLAUDE_CONFIG_DIR="$dir" XDG_CACHE_HOME="$cache" timeout 30 /usr/share/omarchy/bin/omarchy-agent-usage-claude \
    --limits-only --force 2>/dev/null | fmt "$acc"
done
# Codex's collector fails intermittently ("Codex limits unavailable"). Fallback: the limits Codex itself writes to
# its latest session (rate_limits; 300-min window = 5h, 10080 = week). Window already reset → 0%.
codex_from_session() {
  local f; f=$(ls -t "$HOME"/.codex/sessions/*/*/*/*.jsonl 2>/dev/null | head -1)
  [ -n "$f" ] || { echo "codex 5h=? week=? [no limit data]"; return; }
  grep '"rate_limits":{' "$f" | tail -1 | jq -r --argjson now "$(date +%s)" \
    --arg age "$(( ($(date +%s) - $(stat -c %Y "$f")) / 60 ))" '
    ([.. | objects | .rate_limits? | objects] | last) as $r | if $r == null then "codex 5h=? week=? [no limit data]" else
    def win(m): [$r.primary, $r.secondary | select(. != null and .window_minutes == m)] | first;
    def show(w): if w == null then "-" elif (w.resets_at // 0) < $now then "0%" else "\(w.used_percent|floor)%" end;
    "codex 5h=\(show(win(300))) week=\(show(win(10080))) [from the last session, \($age) min ago]" end' 2>/dev/null \
    || echo "codex 5h=? week=? [no limit data]"
}
if want codex "$@"; then
  line=$(timeout 30 /usr/share/omarchy/bin/omarchy-agent-usage-codex --limits-only --force 2>/dev/null | fmt codex)
  case $line in *"5h=? week=?"*) codex_from_session ;; *) echo "$line" ;; esac
fi
# OpenCode (MiniMax provider): no quota collector. "-" = not limiting; a 429/limit error in a child → switch vendor.
want opencode "$@" && echo "opencode 5h=- week=- [no quota collector for MiniMax]"
# Antigravity (agy): no quota collector. "-" = not limiting; use orq-block when its quota runs out.
want antigravity "$@" && echo "antigravity 5h=- week=- [no quota collector]"
