#!/usr/bin/env bash
# herdr-baseline → `orq baseline` (TypeScript CLI in src/, built to dist/ by install.sh). Kept so existing callers keep
# working; same flags (-w -r -b [-g], -p ignored, -x runs in the foreground), output file and exit codes.
# As before, the run opens in a herdr tab whenever the herdr server is up (ORQ_TERMINAL overrides).
command -v herdr >/dev/null && herdr status server >/dev/null 2>&1 && export ORQ_TERMINAL=${ORQ_TERMINAL:-herdr}
exec node "$(dirname "$(realpath "$0")")/../dist/cli.js" baseline "$@"
