#!/usr/bin/env bash
# herdr-board → `orq board` (TypeScript CLI in src/, built to dist/ by install.sh). Kept so the herdr plugin and
# existing tabs keep working. HERDR_BOARD_WS (space separated) and HERDR_BOARD_INTERVAL still apply.
args=()
for w in ${HERDR_BOARD_WS:-}; do args+=(-w "$w"); done
[ -n "${HERDR_BOARD_INTERVAL:-}" ] && args+=(--interval "$HERDR_BOARD_INTERVAL")
exec node "$(dirname "$(realpath "$0")")/../dist/cli.js" board "${args[@]}" "$@"
