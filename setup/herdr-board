#!/usr/bin/env bash
# Live orchestration board, to keep in a pinned herdr tab: test queue (herdr-verify/-baseline), running agents
# (herdr-agent-* scopes), conductors ("conductor" panes) with their issues, memory and quota.
# Read only: /proc/locks, systemd --user, `herdr pane list`, .orquestra/ and the agent-quota cache.
#
#   herdr-board --once     prints once (to check)
#   herdr-board            refreshes every HERDR_BOARD_INTERVAL s (default 3)
#   keys: q quits · f jumps to the pane of a line (gum) · r refreshes the quota now
# Workspaces read (claims and .orquestra): HERDR_BOARD_WS, space separated (default: orq-config's workspace or the current folder).
set -uo pipefail
_ws=$(orq-config get _workspace 2>/dev/null); [ -n "$_ws" ] && [ "$_ws" != null ] || _ws=$PWD
WSS=(${HERDR_BOARD_WS:-$_ws}); INT=${HERDR_BOARD_INTERVAL:-3}
LOCK=${VERIFY_LOCK:-${XDG_RUNTIME_DIR:-/tmp}/herdr-verify.lock}
QCACHE=${XDG_RUNTIME_DIR:-/tmp}/herdr-board.quota; QTTL=300
JUMPS=${XDG_RUNTIME_DIR:-/tmp}/herdr-board.$$.jumps

B=$'\e[1m'; D=$'\e[2m'; R=$'\e[0m'; G=$'\e[32m'; Y=$'\e[33m'; RE=$'\e[31m'; C=$'\e[36m'; M=$'\e[35m'

dur() { local s=${1:-0}; if ((s<60)); then echo "${s}s"; elif ((s<3600)); then printf '%dm%02ds' $((s/60)) $((s%60))
  elif ((s<86400)); then printf '%dh%02dm' $((s/3600)) $((s%3600/60)); else printf '%dd%02dh' $((s/86400)) $((s%86400/3600)); fi; }
gb() { awk -v b="${1:-0}" 'BEGIN{ if (b+0>0) printf "%.1f GB", b/1073741824; else printf "-" }'; }
age() { ps -o etimes= -p "$1" 2>/dev/null | tr -d ' '; }
# Walk up the parents to the herdr-verify/-baseline process (the lock may sit in a child that inherited the fd).
script_of() { local p=$1 i; for i in 1 2 3 4 5 6 7 8; do
    [ -r /proc/$p/cmdline ] || return 1
    tr '\0' ' ' </proc/$p/cmdline | grep -qE 'herdr-(verify|baseline) -x' && { echo "$p"; return 0; }
    p=$(ps -o ppid= -p "$p" | tr -d ' '); [ -n "$p" ] && [ "$p" -gt 1 ] || return 1; done; return 1; }
arg() { tr '\0' '\n' </proc/$1/cmdline | grep -A1 -x -- "$2" | tail -1; }
# Memory of the (systemd-run) scope where some descendant of $1 runs.
scope_mem() { local q=($1) p f; while [ ${#q[@]} -gt 0 ]; do p=${q[0]}; q=("${q[@]:1}")
    f=$(grep -o '[^/]*\.scope$' /proc/$p/cgroup 2>/dev/null | grep -E '^(run-|herdr-agent-)' | head -1)
    [ -n "$f" ] && { systemctl --user show -p MemoryCurrent --value "$f"; return; }
    q+=($(pgrep -P "$p")); done; }

quota() {
  local m; m=$(stat -c %Y "$QCACHE" 2>/dev/null || echo 0)
  # Collect in the background, detached from the board (setsid) and under flock: a dead collector never leaves a stuck lock.
  if (( $(date +%s) - m > QTTL )); then
    setsid bash -c 'exec 8>"$1.lock"; flock -n 8 || exit 0; agent-quota > "$1.tmp" 2>/dev/null && [ -s "$1.tmp" ] && mv -f "$1.tmp" "$1"' _ "$QCACHE" \
      </dev/null >/dev/null 2>&1 &
  fi
  [ -s "$QCACHE" ] || { echo "${D}collecting...${R}"; return; }
  awk '{ pct=0; for(i=2;i<=3;i++){ v=$i; sub(/.*=/,"",v); sub(/%/,"",v); if (v ~ /^[0-9]+$/ && v+0>pct) pct=v+0 }
         col = pct>=90 ? "\033[31m" : pct>=70 ? "\033[33m" : "\033[32m"; if ($0 ~ /\?/) col="\033[2m"
         printf "%s%s %s %s\033[0m  ", col, $1, $2, $3 }' "$QCACHE"
  echo "${D}($(dur $(( $(date +%s) - m ))) ago)${R}"
}

render() {
  local out="" now; now=$(date +%H:%M:%S); : > "$JUMPS"
  local panes; panes=$(herdr pane list 2>/dev/null | jq -c '.result.panes // []'); [ -n "$panes" ] || panes='[]'
  local wsl; wsl=$(herdr workspace list 2>/dev/null | jq -c '[.result.workspaces[]?|{(.workspace_id):.label}]|add // {}')
  read -r mt ma < <(awk '/MemTotal/{t=$2}/MemAvailable/{a=$2}END{print t, a}' /proc/meminfo)
  local used=$(( (mt-ma)*1024 )) pct=$(( (mt-ma)*100/mt )) bar="" i col=$G
  ((pct>=85)) && col=$RE || { ((pct>=70)) && col=$Y; }
  for i in $(seq 1 20); do ((i*5<=pct)) && bar+="▓" || bar+="░"; done
  out+="${B} ORQ${R} ${D}· ${WSS[*]/#$HOME/\~}${R}$(printf '%*s' 6 '')mem ${col}$(gb $used)/$(gb $((mt*1024))) ${bar}${R}  ${D}${now}${R}\n\n"

  # Test queue: holder and waiters in kernel order (/proc/locks: holder without "->", waiters with "->").
  out+="${B} TEST QUEUE${R}\n"
  local ino n=0 line pid sp o kind id repo top=() waiting=" " shown=0; ino=$(stat -c %i "$LOCK" 2>/dev/null)
  # /proc/locks records the pid of the `flock` that took the lock (and exited): the holder is the script with no waiting `flock` child.
  for sp in $(pgrep -f 'setup/herdr-(verify|baseline) -x'); do
    pid=$(ps -o ppid= -p "$sp" | tr -d ' '); tr '\0' ' ' </proc/$pid/cmdline 2>/dev/null | grep -qE 'herdr-(verify|baseline) -x' || top+=("$sp"); done
  qline() { local sp=$1 st=$2 w=${3:-} kind=verify repo o id
    tr '\0' ' ' </proc/$sp/cmdline | grep -q herdr-baseline && kind=baseline
    repo=$(arg "$sp" -r); o=$(arg "$sp" -o); id=$([ $kind = verify ] && basename "$(dirname "$o")" || echo "—")
    if [ "$st" = run ]; then
      out+=" ${G}▶${R} $(printf '%-9s %-8s %-20s' "$id" "$kind" "$repo") ${G}running${R}  $(printf '%-7s' "$(dur "$(age "$(pgrep -o -P "$sp" || echo "$sp")")")") $(gb "$(scope_mem "$sp")")"
      [ $kind = baseline ] && out+="  ${Y}full suite${R}"; out+="\n"
    else out+=" ${Y}${w}${R} $(printf '%-9s %-8s %-20s' "$id" "$kind" "$repo") ${D}waiting  $(dur "$(age "$sp")")${R}\n"; fi
    echo "$id $kind $repo|$id $kind $repo" >> "$JUMPS"; }
  if [ -n "$ino" ]; then
    while read -r line; do   # queue in kernel order
      pid=$(awk '{for(i=1;i<=NF;i++) if($i=="WRITE"){print $(i+1); exit}}' <<<"$line")
      sp=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' '); [ -n "$sp" ] && waiting+="$sp "
    done < <(grep ":$ino " /proc/locks | grep -- '->')
    for sp in "${top[@]}"; do [[ $waiting == *" $sp "* ]] || { qline "$sp" run; shown=1; }; done
    for sp in $waiting; do n=$((n+1)); qline "$sp" wait "$n"; shown=1; done
  fi
  ((shown)) || out+=" ${D}empty${R}\n"

  # Agents: live herdr-agent-* scopes ↔ the <prefix>.run.sh that created them.
  out+="\n${B} AGENTS${R}\n"
  local u rs pre lab ag mdl el mem act k=0
  while read -r u; do
    [ -n "$u" ] || continue; k=$((k+1))
    rs=$(grep -l -- "--unit=${u%.scope} " "${WSS[@]/%//.orquestra}"/*/*.run.sh 2>/dev/null | head -1)
    el=$(( $(date +%s) - $(date -d "$(systemctl --user show -p ActiveEnterTimestamp --value "$u")" +%s) ))
    mem=$(systemctl --user show -p MemoryCurrent --value "$u")
    if [ -z "$rs" ]; then out+=" ${RE}?${R} ${D}${u} — no .run.sh (orphan?)${R}  $(dur $el)  $(gb "$mem")\n"; continue; fi
    pre=${rs%.run.sh}; id=$(basename "$(dirname "$pre")"); lab=$(basename "$pre")
    ag=$(grep -oE '(codex|claude|opencode) (exec|-p|run)?' "$rs" | head -1 | cut -d' ' -f1); grep -q 'TUI' "$rs" && ag+="·tela"
    mdl=$(grep -oE -- '(-m|--model) [^ ]+' "$rs" | head -1 | cut -d' ' -f2); mdl=${mdl##*/}
    grep -qE 'codex exec resume|codex resume|--resume|opencode run .* -s ' "$rs" && mdl="${mdl:-session} (follow-up)"
    act=""
    if [ -s "$pre.log" ]; then
      act=$(tail -n 40 "$pre.log" | jq -r 'if .type=="assistant" then (.message.content[]?|if .type=="tool_use" then "· "+.name else empty end)
              elif .type=="tool_use" then "· "+(.part.tool//"tool") elif .type=="text" then .part.text else empty end' 2>/dev/null | tail -1)
      [ -n "$act" ] || act=$(tail -n 5 "$pre.log" | grep -v '^\s*$' | grep -v '^{' | tail -1)
    fi
    act=$(tr -s '\n\t ' ' ' <<<"$act" | sed "s|$HOME/Code/[^ ]*/||g" | cut -c1-48)
    local warn=""; ((el>3*3600)) && warn=" ${RE}⚠ for $(dur $el)${R}"
    out+=" ${C}●${R} $(printf '%-9s %-24s %-24s %-7s %-7s' "$id" "${lab}" "$ag ${mdl:-default}" "$(dur $el)" "$(gb "$mem")") ${D}${act}${R}${warn}\n"
    echo "$id ${lab}|$(cat "$pre.pane" 2>/dev/null)" >> "$JUMPS"
  done < <(systemctl --user list-units --type=scope --state=running --no-legend --plain 'herdr-agent-*' 2>/dev/null | awk '{print $1}')
  ((k==0)) && out+=" ${D}none${R}\n"

  # Conductors: panes "conductor"; issues pelo herdr-claim; estado pelo herdr.
  out+="\n${B} CONDUCTORS${R}\n"
  local claims=""; for w in "${WSS[@]}"; do claims+=$(herdr-claim -w "$w" -l 2>/dev/null | grep '(alive)'); claims+=$'\n'; done
  while IFS=$'\t' read -r p st w; do
    local is name ic txt
    is=$(awk -v p="pane=$p" '$2==p{printf "%s ", $1}' <<<"$claims"); name=$(jq -r --arg w "$w" '.[$w] // $w' <<<"$wsl")
    case $st in working) ic="${G}●"; txt="working";; blocked) ic="${RE}⚠"; txt="asking for approval";;
      done) ic="${Y}⏸"; txt="done — your turn";; idle) ic="${D}○"; txt="idle";; *) ic="${D}?"; txt=$st;; esac
    out+=" ${ic}${R} $(printf '%-8s %-22s %-26s' "$p" "${name:0:22}" "${is:-—}") ${ic} ${txt}${R}\n"
    echo "conductor ${name} (${is:-—})|$p" >> "$JUMPS"
  done < <(jq -r '.[]|select(.label=="conductor")|[.pane_id,.agent_status,(.pane_id|split(":")[0])]|@tsv' <<<"$panes")

  local nt; nt=$(jq '[.[]|select(.agent==null and .label!=null and (.label|test("^[A-Z]+-[0-9]+ ")))]|length' <<<"$panes")
  out+="\n${B} QUOTA${R}   $(quota)\n"
  out+="\n${D} ${nt} child tabs open · q quit · f jump to a pane · r refresh quota${R}"
  # Jump to a verify: pane by the tab label.
  awk -F'|' '$2 !~ /:/' "$JUMPS" | while IFS='|' read -r t _; do
    set -- $t; pn=$(jq -r --arg l "$1 $2 $3" '[.[]|select(.label==$l)]|last|.pane_id // empty' <<<"$panes")
    [ -n "$pn" ] && echo "$t|$pn"; done > "$JUMPS.v"
  { grep ':' "$JUMPS" | awk -F'|' '$2 ~ /:/'; cat "$JUMPS.v"; } > "$JUMPS.all"
  # \e[K at the end of each line: a shorter line leaves no leftovers from the previous frame.
  { printf '\e[H'; printf '%b\n' "$out" | sed $'s/$/\e[K/'; printf '\e[J'; }
}

jump() {
  [ -s "$JUMPS.all" ] || return; command -v gum >/dev/null || return
  printf '\e[H\e[J'; tput cnorm
  local sel; sel=$(cut -d'|' -f1 "$JUMPS.all" | gum filter --placeholder "jump to..." --height 15) || { tput civis; return; }
  local pn; pn=$(grep -F "$sel|" "$JUMPS.all" | head -1 | cut -d'|' -f2)
  [ -n "$pn" ] && { herdr agent focus "$pn" >/dev/null 2>&1 || herdr tab focus "$(herdr pane get "$pn" | jq -r .result.pane.tab_id)" >/dev/null 2>&1; }
  tput civis
}

[ "${1:-}" = --once ] && { render; echo; rm -f "$JUMPS" "$JUMPS".*; exit 0; }
trap 'tput cnorm; rm -f "$JUMPS" "$JUMPS".*; printf "\n"; exit 0' INT TERM EXIT
tput civis; printf '\e[2J'
while :; do
  render
  read -rsn1 -t "$INT" key || continue
  case $key in q) exit 0;; f) jump; printf '\e[2J';; r) rm -f "$QCACHE";; esac
done
